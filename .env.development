# ==========================================================================
# Development VM config  (psvbot-development, us-central1-f, nametag-agent)
#
# HOW THIS IS USED
#   The development deploy workflow scp's this file to the VM, copies it to
#   $APP_DIR/.env, then appends the `DEV_APP_ENV_FILE` environment secret to
#   the end. systemd's EnvironmentFile parser takes the LAST occurrence of a
#   duplicate key, so anything in the secret overrides a value set here.
#
# THIS FILE IS COMMITTED TO GIT -- NO CREDENTIALS HERE.
#   Exactly three keys live in the DEV_APP_ENV_FILE secret:
#     API_BEARER_TOKEN
#     MONGO_URL
#     MAIN_SERVER_API_TOKEN
#   Everything else is safe to edit here and ships on the next push.
#
#   Do not add APP_BUILD_SHA -- deploy_gcp_vm.sh appends it itself and the
#   health check compares it against the deployed commit.
# ==========================================================================

APP_NAME=PSVBot API (development)
APP_VERSION=0.1.0
DEBUG=false
PORT=8001

API_BEARER_SUBJECT=psvbot-service
API_BEARER_ROLE=service

CORS_ALLOW_ORIGINS=*

# --- queue isolation ------------------------------------------------------
# MONGO_URL comes from the secret. MONGO_DB must never be the production
# database: this VM's workers claim any task whose machine_name is unset,
# and _fetch_next_callback_task ignores MACHINE_NAME entirely.
MONGO_DB=alphagraphics-queue-service-development
MACHINE_NAME=psvbot-development
QUEUE_ENFORCE_MACHINE_ASSIGNMENT=true

QUEUE_WORKER_CONCURRENCY=2
QUEUE_MAX_ATTEMPTS=3
QUEUE_POLL_INTERVAL_SECONDS=0.2
QUEUE_PROCESSING_STALE_SECONDS=900
QUEUE_RECOVERY_INTERVAL_SECONDS=60

# --- Playwright -----------------------------------------------------------
# Headless is mandatory: the VM has no display server.
PRINTSMITH_HEADLESS=true
PRINTSMITH_TIMEOUT_SECONDS=300
PRINTSMITH_KEEP_BROWSER_OPEN=false
PRINTSMITH_DEBUG=false
PRINTSMITH_CHROME_BINARY=
PRINTSMITH_CHROMEDRIVER_PATH=
PRINTSMITH_QUOTE_SUMMARY_STORAGE_ROOT=estimates
PRINTSMITH_ESTIMATE_HISTORY_STORAGE_ROOT=estimate-history

# --- storage --------------------------------------------------------------
BUCKET_NAME=psv_alpha_graphics
BUCKET_REGION=us-east1
# Uploaded to the VM by hand -- *.json is gitignored and not in the scp list.
GOOGLE_APPLICATION_CREDENTIALS=/home/psvbot/psvbot-development/sa.json

# --- main server ----------------------------------------------------------
# Token comes from the secret.
MAIN_SERVER_API_BASE_URL=http://localhost:8000/api/v1
