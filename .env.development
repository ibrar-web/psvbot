# ==========================================================================
# Development VM config -- psvbot-development (34.71.243.127, us-central1-f)
#
# Derived from .env with the deployment overrides applied. Three credentials
# are deliberately NOT here, because this file is committed to git; they come
# from the DEV_APP_ENV_FILE environment secret:
#
#     API_BEARER_TOKEN
#     MONGO_URL
#     PRINTSMITH_PASSWORD
#     MAIN_SERVER_API_TOKEN   (empty in .env -- only needed if the endpoint
#                              receiving results requires auth)
#
# The deploy workflow scp's this file to the VM, copies it to .env, then
# appends that secret. Duplicate keys resolve last-wins in both systemd and
# python-dotenv, so the secret overrides anything set here. To inline a value
# instead, just add it below and drop it from the secret.
#
# Do not add APP_BUILD_SHA -- deploy_gcp_vm.sh appends it itself and the
# health check compares it against the deployed commit.
# ==========================================================================

APP_NAME=PSVBot API (development)
APP_VERSION=0.1.0
DEBUG=true
PORT=8001

API_BEARER_SUBJECT=psvbot-service
API_BEARER_ROLE=service

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- queue ----------------------------------------------------------------
# Own database: machine_name routing does NOT isolate a bot on its own.
# _fetch_next_callback_task and _recover_stale_processing_tasks both query
# without any machine filter, so two bots sharing a database will claim each
# other's callback tasks and reset each other's in-flight jobs.
MONGO_DB=alphagraphics-queue-shaheer-gcp
MACHINE_NAME=shaheer-gcp
QUEUE_ENFORCE_MACHINE_ASSIGNMENT=true

# Carried over from .env. Note this is 60 SECONDS between polls, so a queued
# job can sit for up to a minute before a worker picks it up (.env.local uses
# 0.2). Lower it if that makes testing feel unresponsive.
QUEUE_POLL_INTERVAL_SECONDS=60
QUEUE_WORKER_CONCURRENCY=4
QUEUE_MAX_ATTEMPTS=3
QUEUE_PROCESSING_STALE_SECONDS=900
QUEUE_RECOVERY_INTERVAL_SECONDS=60

# --- Playwright -----------------------------------------------------------
# Headless is mandatory here: the VM has no display server.
PRINTSMITH_HEADLESS=true
PRINTSMITH_KEEP_BROWSER_OPEN=false
PRINTSMITH_DEBUG=true
PRINTSMITH_TIMEOUT_SECONDS=300
PRINTSMITH_PAGE_LOAD_TIMEOUT_SECONDS=60
PRINTSMITH_RECOVERY_HOME_LOAD_TIMEOUT_SECONDS=120

# Fallbacks, used only when a task carries no tenant_credentials.
PRINTSMITH_URL=https://alphagraphics685.myprintdesk.net/PrintSmith/PrintSmith.html
PRINTSMITH_USERNAME=raza
# Left blank on purpose: _build_runtime_credentials derives the company from
# PRINTSMITH_URL's hostname when this is empty. .env still has the
# "your-company" placeholder from .env.example, which would be wrong here.
PRINTSMITH_COMPANY=

PRINTSMITH_QUOTE_SUMMARY_STORAGE_ROOT=estimates
PRINTSMITH_ESTIMATE_HISTORY_STORAGE_ROOT=estimate-history

# --- storage --------------------------------------------------------------
BUCKET_NAME=psv_alpha_graphics
BUCKET_REGION=us-east1
# Absolute path on this VM. CI never uploads this file -- *.json is gitignored
# and absent from the workflow's scp source list, so scp it by hand.
GOOGLE_APPLICATION_CREDENTIALS=/home/psvbot/psvbot-development/sa.json

# --- main server ----------------------------------------------------------
# Only consulted when an enqueued payload carries no quote/requirements/
# tenant_credentials: the bot then GETs
# {base}/quotation/job/{queue_id}/quote-detail to fetch them itself.
MAIN_SERVER_API_BASE_URL=https://alphagraphics-multitenant-testing-873492034850.us-central1.run.app/api/v1

# --- inert keys ------------------------------------------------------------
# Present in .env but read by nothing on this branch. Kept commented so it is
# clear they were considered rather than forgotten.
# QUEUE_IDLE_POLL_INTERVAL_SECONDS=10
# QUEUE_BUSY_POLL_INTERVAL_SECONDS=60
# BOT_LOG_LOCAL_DIR=logs
# BOT_LOG_STORAGE_ROOT=logs
# BOT_LOG_ARCHIVE_RUN_HOUR=0
# BOT_LOG_ARCHIVE_RUN_MINUTE=10
